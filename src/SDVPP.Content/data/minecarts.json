{
  "Changes": [
    {
      "LogName": "Minecart destinations",
      "Action": "EditData",
      "Target": "Data/Minecarts",
      "TargetField": [ "Default", "Destinations" ],
      "Entries": {
        // arrive on the tile below the cart, like the vanilla stops
        "{{ModId}}_Forest": {
          "Id": "{{ModId}}_Forest",
          "DisplayName": "{{i18n: minecart.forest}}",
          "TargetLocation": "Forest",
          "TargetTile": { "X": 77, "Y": 9 },
          "TargetDirection": "down"
        },
        "{{ModId}}_Beach": {
          "Id": "{{ModId}}_Beach",
          "DisplayName": "{{i18n: minecart.beach}}",
          "TargetLocation": "Beach",
          "TargetTile": { "X": 40, "Y": 7 },
          "TargetDirection": "down"
        }
      }
    },
    {
      "LogName": "Forest minecart touch-ups",
      "Action": "Load",
      // hand-drawn pixels that blend the cave into the cliff, one strip per season
      "Target": "Maps/z_SDVPP_ForestTouchup",
      "FromFile": "assets/forest-minecart-touchup-{{Lowercase: {{Season}}}}.png"
    },
    {
      "LogName": "Forest minecart",
      "Action": "EditMap",
      "Target": "Maps/Forest",
      // the track comes out of a cave in the cliff east of the path from the farm
      "FromFile": "assets/forest-minecart.tmx",
      "ToArea": { "X": 75, "Y": 2, "Width": 5, "Height": 8 },
      "PatchMode": "Overlay"
    },
    {
      "LogName": "Forest minecart cave and arrival",
      "Action": "EditMap",
      "Target": "Maps/Forest",
      "MapTiles": [
        // open the cliff where the cave is: the top of the arch is on Front, the floor is walkable
        { "Position": { "X": 77, "Y": 4 }, "Layer": "Buildings", "Remove": true },
        { "Position": { "X": 77, "Y": 6 }, "Layer": "Buildings", "Remove": true },
        // keep forage and artifact spots off the arrival tile
        { "Position": { "X": 77, "Y": 9 }, "Layer": "Back", "SetProperties": { "NoSpawn": "All" } }
      ]
    },
    {
      "LogName": "Forest minecart in winter",
      "Action": "EditMap",
      "Target": "Maps/Forest",
      // the dirt in front of the cave turns into a square snow patch in winter, so use the plain ground there instead
      "MapTiles": [
        { "Position": { "X": 76, "Y": 6 }, "Layer": "Back", "SetTilesheet": "outdoors", "SetIndex": 407 },
        { "Position": { "X": 76, "Y": 7 }, "Layer": "Back", "SetTilesheet": "outdoors", "SetIndex": 404 },
        { "Position": { "X": 77, "Y": 7 }, "Layer": "Back", "SetTilesheet": "outdoors", "SetIndex": 407 },
        { "Position": { "X": 78, "Y": 7 }, "Layer": "Back", "SetTilesheet": "outdoors", "SetIndex": 380 }
      ],
      "When": { "Season": "Winter" }
    },
    {
      "LogName": "Beach minecart",
      "Action": "EditMap",
      "Target": "Maps/Beach",
      // a track down the east edge of the path from town, ending in the cart on the sand
      "FromFile": "assets/beach-minecart.tmx",
      "ToArea": { "X": 40, "Y": 0, "Width": 3, "Height": 8 },
      "PatchMode": "Overlay"
    },
    {
      "LogName": "Beach minecart arrival",
      "Action": "EditMap",
      "Target": "Maps/Beach",
      "MapTiles": [
        { "Position": { "X": 40, "Y": 7 }, "Layer": "Back", "SetProperties": { "NoSpawn": "All" } },
        // the driftwood log at the top of the track
        { "Position": { "X": 40, "Y": 0 }, "Layer": "Buildings", "Remove": true }
      ]
    }
  ]
}
